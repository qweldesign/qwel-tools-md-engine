# サイト全体の設定 (Apache)

# 存在しない URL は inc/404.php で表示する
# ※ パスはドメインからの絶対パス. templates/config.php の SITE_ROOT に合わせて書き換える (例: /tools/simple-cms/inc/404.php)
ErrorDocument 404 /inc/404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # サイトのルートの URL (例: /tools/simple-cms/) を BASE に入れる
  RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
  RewriteRule ^(.*)$ - [E=BASE:%1]

  # www なしの URL に揃える場合は, 次の 2 行を自分のドメインに書き換えて有効にする
  # RewriteCond %{HTTP_HOST} ^www\.example\.com$ [NC]
  # RewriteRule ^(.*)$ https://example.com/$1 [R=301,L]

  # サイトマップは inc/sitemap.php が原稿から作る
  RewriteRule ^sitemap\.xml$ inc/sitemap.php [L]

  # robots.txt は inc/robots.php が templates/config.php から作る
  RewriteRule ^robots\.txt$ inc/robots.php [L]

  # 固定ページの入口を直接開いた場合は, きれいな URL へ恒久的に転送する
  # (THE_REQUEST を見ることで, 下の内部の書き換えでは転送がループしない)
  RewriteCond %{THE_REQUEST} \s[^?\s]*\?(?:[^\s&]*&)*slug=([A-Za-z0-9_-]+)[\s&]
  RewriteRule ^page/(?:index\.php)?$ %{ENV:BASE}%1/? [R=301,L]
  RewriteRule ^page/([A-Za-z0-9_-]+)/?$ %{ENV:BASE}$1/ [R=301,L]

  # 固定ページ (/xxx/). 実在するファイルとフォルダが優先される
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([A-Za-z0-9_-]+)$ %{ENV:BASE}$1/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([A-Za-z0-9_-]+)/$ page/index.php?slug=$1 [L,QSA]
</IfModule>
