# お問い合わせフォームの秘密の値
# このファイルを .env という名前でコピーし, 値を書き換えて使う
# .env にはパスワードが含まれるため, Git には含めない (.gitignore 済み)
# サイト名, URL, 項目, 自動返信の署名などは config.php に書く

# 送信元, 管理者宛の通知先
ADMIN_EMAIL="webmaster@qwel.design"

# SMTP の設定
SMTP_HOST="smtp.example.com"
SMTP_USER="webmaster@qwel.design"
SMTP_PASS="********"
SMTP_PORT=587
# tls (STARTTLS, 通常は 587 番), ssl (SMTPS, 通常は 465 番), none (暗号化なし. 手元のテスト用のみ)
SMTP_SECURE=tls
